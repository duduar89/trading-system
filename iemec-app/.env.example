# Copiar a .env (nunca se sube a git). En cPanel, estas mismas variables en «Setup Node.js App».
NODE_ENV=development
PORT=3004
URL_PUBLICA=http://localhost:3004

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iemec
DB_PASSWORD=iemec_local
DB_NAME=iemec_dev
# DB_CONEXIONES=5

# Clave maestra para cifrar conversaciones y notas (64 hex = 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_CIFRADO=
# Firma de la cookie de sesión del panel (32 caracteres aleatorios o más).
SESION_SECRETO=
# Clave de acceso del personal (12 caracteres o más). Fuera de producción, MODO_DEMO=1 entra solo.
PANEL_CLAVE=
# MODO_DEMO=1

# simulado | real. En «simulado» nunca sale nada a internet.
MODO_WHATSAPP=simulado
MODO_IA=simulado
MODO_GOOGLE=simulado
MODO_META=simulado
MODO_CORREO=simulado

# WhatsApp (webhook de Meta o de 360dialog): ver docs/WHATSAPP-Y-LEADS.md
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Solo si el proveedor no firma con nuestra app (360dialog): clave que manda en la cabecera X-Clave.
WHATSAPP_WEBHOOK_CLAVE=

# Leads de los formularios de Meta (Lead Ads)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_TOKEN_PAGINA=
# META_GRAPH_VERSION=v23.0

# Alta de leads desde la web o GHL: POST /api/leads con la cabecera X-Clave (16 caracteres o más).
LEADS_CLAVE=

# IA (Claude por Google Vertex en la UE). Con MODO_IA=real hacen falta el proyecto y el modelo.
# IA_PROVEEDOR=vertex
# IA_PROYECTO_GCP=
# IA_REGION=eu
# IA_MODELO=
# IA_MODELO_RESPALDO=
# IA_ESFUERZO_INTERPRETAR=low
# IA_ESFUERZO_REDACTAR=medium
