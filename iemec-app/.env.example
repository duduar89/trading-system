# Copiar a .env (nunca se sube a git). En cPanel, estas mismas variables en «Setup Node.js App».
NODE_ENV=development
PORT=3004
URL_PUBLICA=http://localhost:3004

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iemec
DB_PASSWORD=iemec_local
DB_NAME=iemec_dev
# DB_CONEXIONES=5

# Clave maestra para cifrar conversaciones y notas (64 hex = 32 bytes). También la pide el
# importador de Flowww para --aplicar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_CIFRADO=
# Firma de la sesión del panel y de la huella de las IP del límite de intentos (32 caracteres o más;
# obligatoria en producción).
SESION_SECRETO=
# El personal entra con passkeys (la primera persona de dirección: npm run invitar). URL_PUBLICA da el
# dominio de las passkeys: en producción, https; si cambia, cada persona crea su passkey otra vez.
# Opcional: acceso de emergencia de dirección (16 caracteres o más, sesión de una hora, cada uso queda
# apuntado). Sin ella, solo passkeys; mientras esté puesta, el servidor avisa al arrancar.
PANEL_CLAVE=
# Fuera de producción, MODO_DEMO=1 entra sin passkey como dirección.
# MODO_DEMO=1

# simulado | real. En «simulado» nunca sale nada a internet.
MODO_WHATSAPP=simulado
MODO_IA=simulado
MODO_GOOGLE=simulado
MODO_META=simulado
MODO_CORREO=simulado

# WhatsApp (webhook de Meta o de 360dialog): ver docs/WHATSAPP-Y-LEADS.md
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Solo si el proveedor no firma con nuestra app (360dialog): clave que manda en la cabecera X-Clave.
WHATSAPP_WEBHOOK_CLAVE=

# Leads de los formularios de Meta (Lead Ads)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_TOKEN_PAGINA=
# META_GRAPH_VERSION=v23.0

# Alta de leads desde GHL u otra herramienta: POST /api/leads con la cabecera X-Clave (16 caracteres o más).
LEADS_CLAVE=

# Formulario «Te llamamos» de la web pública: POST /web/contacto, sin clave (lo manda el navegador).
# WEB_DOMINIO es la web (adónde vuelve quien envía sin JavaScript y el origen que puede llamar con
# CORS); WEB_ORIGENES, otros orígenes permitidos separados por comas (p. ej. un subdominio de prueba).
# WEB_DOMINIO=https://iemec-clinic.com
# WEB_ORIGENES=

# IA (Claude por Google Vertex en la UE). Con MODO_IA=real hacen falta el proyecto y el modelo.
# IA_PROVEEDOR=vertex
# IA_PROYECTO_GCP=
# IA_REGION=eu
# IA_MODELO=
# IA_MODELO_RESPALDO=
# IA_ESFUERZO_INTERPRETAR=low
# IA_ESFUERZO_REDACTAR=medium

# Solo para las pruebas con navegador (panel y passkeys): ruta a un Chromium. Si no se pone, se usa el
# de /opt/pw-browsers o el que haya instalado Playwright; sin ninguno, esas pruebas se saltan.
# CHROMIUM_RUTA=
