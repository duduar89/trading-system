# Copiar a .env (nunca se sube a git). En Vercel, estas mismas variables en Settings → Environment Variables.
NODE_ENV=development
PORT=3004
URL_PUBLICA=http://localhost:3004

# Base de datos: PostgreSQL (el del portátil o el de Supabase). O la cadena entera que da Supabase…
# DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# …o los datos sueltos (con DATABASE_URL puesta, estos cinco no se leen):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=iemec
DB_PASSWORD=iemec_local
DB_NAME=iemec_dev
# Cifrado: auto (TLS verificado salvo en localhost) | require | disable (solo localhost). El certificado
# del servidor SIEMPRE se verifica; para Supabase va incluido (servidor/certs). Otro: DB_SSL_CA=ruta o PEM.
# DB_SSL=auto
# DB_SSL_CA=
# Conexiones abiertas a la vez: 5 en un servidor; en Vercel (funciones sin servidor), 1 a 3.
# DB_CONEXIONES=5
# Con el pooler de Supabase: auto (por el puerto: 6543 = transacción) | transaccion | sesion.
# DB_MODO_POOLER=auto
# Las migraciones (npm run migrar, preparar-bd) no pueden ir por el pooler en modo transacción: si la app
# usa el puerto 6543, aquí la conexión directa o el pooler en modo sesión (puerto 5432).
# DATABASE_URL_MIGRACIONES=

# Clave maestra para cifrar conversaciones y notas (64 hex = 32 bytes). También la pide el
# importador de Flowww para --aplicar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_CIFRADO=
# Firma de la sesión del panel y de la huella de las IP del límite de intentos (32 caracteres o más;
# obligatoria en producción).
SESION_SECRETO=
# El personal entra con passkeys (la primera persona de dirección: npm run invitar). URL_PUBLICA da el
# dominio de las passkeys: en producción, https; si cambia, cada persona crea su passkey otra vez.
# Opcional: acceso de emergencia de dirección (16 caracteres o más, sesión de una hora, cada uso queda
# apuntado). Sin ella, solo passkeys; mientras esté puesta, el servidor avisa al arrancar.
PANEL_CLAVE=
# Fuera de producción, MODO_DEMO=1 entra sin passkey como dirección.
# MODO_DEMO=1

# simulado | real. En «simulado» nunca sale nada a internet.
MODO_WHATSAPP=simulado
MODO_IA=simulado
MODO_GOOGLE=simulado
MODO_META=simulado
MODO_CORREO=simulado

# WhatsApp (webhook de Meta o de 360dialog): ver docs/WHATSAPP-Y-LEADS.md
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Solo si el proveedor no firma con nuestra app (360dialog): clave que manda en la cabecera X-Clave.
WHATSAPP_WEBHOOK_CLAVE=

# Leads de los formularios de Meta (Lead Ads)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_TOKEN_PAGINA=
# META_GRAPH_VERSION=v23.0

# Alta de leads desde GHL u otra herramienta: POST /api/leads con la cabecera X-Clave (16 caracteres o más).
LEADS_CLAVE=

# Formulario «Te llamamos» de la web pública: POST /web/contacto, sin clave (lo manda el navegador).
# WEB_DOMINIO es la web (adónde vuelve quien envía sin JavaScript y el origen que puede llamar con
# CORS); WEB_ORIGENES, otros orígenes permitidos separados por comas (p. ej. un subdominio de prueba).
# WEB_DOMINIO=https://iemec-clinic.com
# WEB_ORIGENES=
# Meses que se guarda un lead de la web (o de su WhatsApp) que no llega a tener cita, desde su último
# contacto (la política de privacidad dice 12). La prueba de un consentimiento comercial, 3 años.
# RETENCION_LEADS_MESES=12

# IA (Claude por Google Vertex en la UE). Con MODO_IA=real hacen falta el proyecto y el modelo.
# IA_PROVEEDOR=vertex
# IA_PROYECTO_GCP=
# IA_REGION=eu
# IA_MODELO=
# IA_MODELO_RESPALDO=
# IA_ESFUERZO_INTERPRETAR=low
# IA_ESFUERZO_REDACTAR=medium

# Solo para las pruebas con navegador (panel y passkeys): ruta a un Chromium. Si no se pone, se usa el
# de /opt/pw-browsers o el que haya instalado Playwright; sin ninguno, esas pruebas se saltan.
# CHROMIUM_RUTA=

# Google Business Profile (reseñas, respuestas, métricas y avisos) y Places: pasos en docs/GOOGLE.md.
# Con MODO_GOOGLE=real hacen falta las tres primeras (o ninguna) y la cuenta y la ficha.
# GOOGLE_CLIENTE_ID=
# GOOGLE_CLIENTE_SECRETO=
# GOOGLE_REFRESH_TOKEN=
# accounts/123… o el número: node scripts/google.js cuentas.
# GOOGLE_CUENTA=
# locations/123… o el número (el mismo comando).
# GOOGLE_UBICACION=
# Places API (New), restringida a esa API y a la IP del servidor.
# GOOGLE_PLACES_CLAVE=
# Si falta, el de la base: clinica.google_place_id.
# GOOGLE_PLACE_ID=
# Opcional, para reconocer la ficha en DataForSEO.
# GOOGLE_CID=
# Cuenta de servicio que firma los avisos; sin ella, en producción /webhooks/google da 503.
# GOOGLE_PUBSUB_EMAIL=
# Por defecto, URL_PUBLICA + /webhooks/google.
# GOOGLE_PUBSUB_AUDIENCIA=

# Posiciones en Google Maps con DataForSEO (simulado por defecto).
# MODO_DATAFORSEO=simulado
# DATAFORSEO_LOGIN=
# DATAFORSEO_CLAVE=
# POSICIONES_TOPE_MES_USD=3
# Por defecto, las 12 del informe de búsqueda local.
# POSICIONES_PALABRAS=
# Puntos por lado, impar de 1 a 15.
# POSICIONES_MALLA=7
# POSICIONES_PASO_KM=1.5
# 0 para no medir Majadahonda, Pozuelo, Las Rozas y Villaviciosa.
# POSICIONES_MUNICIPIOS=1
# Latitud,longitud; por defecto, la de la clínica.
# POSICIONES_CENTRO=
# POSICIONES_ZOOM=15
# POSICIONES_PROFUNDIDAD=20
# 1 = lunes.
# POSICIONES_DIA=1
