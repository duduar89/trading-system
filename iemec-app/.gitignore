node_modules
.env
.env.*
!.env.example
servidor/public/
servidor/commit.txt
dist/
test-results/
playwright-report/
*.log

# Exportaciones de Flowww (CSV) y sus mapas: datos de pacientes, nunca al repositorio (que es público).
# Van fuera de esta carpeta (docs/MIGRAR-FLOWWW.md); los de las pruebas, inventados, sí se suben.
*.csv
mapa*.json
!test/fixtures/**/*.csv
!test/fixtures/**/mapa*.json

# Web pública: lo construido, las capturas y las imágenes se regeneran (npm run web, web:fotos y
# web:revisar). De web/fotos solo va a git fotos.json.
web/dist/
web/dist-borradores/
web/capturas/
web/fotos/*
!web/fotos/fotos.json
# El zip para public_html (node web/construir.js --publicar --zip …) se construye, no se versiona.
*.zip
