{
  "name": "mesa-trading",
  "version": "0.1.0",
  "private": true,
  "description": "Fondo de agentes de IA que opera en papel (Alpaca paper o bróker simulado con 100.000 $), con parqué isométrico en el navegador.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/index.js",
    "start-proxy": "node --use-env-proxy src/index.js",
    "demo": "node src/index.js --modo=sintetico --velocidad=600",
    "demo-rapida": "node scripts/demo-acelerada.js",
    "test": "node --test \"test/*.test.js\"",
    "probar": "node scripts/probar-todo.js",
    "crear-tablas": "node scripts/crear-tablas.js",
    "crear-usuario": "node scripts/crear-usuario.js",
    "latido": "node scripts/latido.js",
    "laboratorio": "node scripts/laboratorio.js",
    "web": "node src/web.js",
    "iconos": "node scripts/generar-iconos.js",
    "probar-web": "node scripts/probar-web.js --navegador"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "mysql2": "3.24.5"
  }
}
