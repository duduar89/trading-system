# Copia este fichero como .env (en esta misma carpeta) y rellena lo que tengas.
# Sin ninguna clave también funciona: precios reales de cripto y bróker simulado.
# El .env NUNCA se sube a git.

# Cuenta PAPER de Alpaca (alpaca.markets → Paper Trading → API Keys)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Claude (console.anthropic.com → API Keys). Opcional.
ANTHROPIC_API_KEY=
# Tope de gasto diario en Claude, en dólares. Al llegar, los agentes siguen con frases hechas.
LLM_PRESUPUESTO_DIA_USD=1
# Modelos. El comité decide con Opus 5.5; los agentes solo redactan y clasifican
# con listas cerradas y van en Haiku 4.5, que cuesta la cuarta parte por token.
# LLM_MODELO_COMITE=claude-opus-5-5
# LLM_MODELO_AGENTES=claude-haiku-4-5

# Panel
# PUERTO=8765
# Si vas a abrir el panel desde otro ordenador: HOST=0.0.0.0 y un PANEL_TOKEN largo.
# HOST=127.0.0.1
# PANEL_TOKEN=

# Cada cuántas horas se reúne el comité
# COMITE_HORAS=4
